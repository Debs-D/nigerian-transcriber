# Get a key at https://www.assemblyai.com/app/api-keys
ASSEMBLYAI_API_KEY=

# The "Shorter, clean version" also uses this key (AssemblyAI LLM Gateway).
# By default it uses the model AssemblyAI allows on accounts without paid credit.
# After adding credit, you can switch to a stronger model, e.g.:
# CLEAN_MODEL=claude-opus-5-5

# Optional
PORT=3000
# Speech models in order of preference (change only if AssemblyAI renames/retires them)
# SPEECH_MODELS=assemblyai-stt-3-7,universal-2
